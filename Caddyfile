# Caddy-Konfiguration – serviert die statische Seite auf dem von Railway gesetzten Port
:{$PORT:80} {
	root * /srv
	encode zstd gzip

	# Sicherheits-Header (gelten für alle Antworten)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Nicht genutzte Browser-Features deaktivieren
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
		-Server
	}

	# /index und /index.html sind Duplikate der Startseite -> direkt 301 auf die Wurzel
	redir /index.html / permanent
	redir /index / permanent

	# Zusammengelegte Duplikate. Diese Seiten trugen bisher nur ein canonical auf
	# die verbleibende Fassung. Ein canonical ist ein Hinweis, eine 301 ist eine
	# Anweisung: sie buendelt Linkkraft sicher und spart Crawl-Budget.
	redir /news-blackjack-anfaenger /online-blackjack permanent
	redir /news-blackjack-anfaenger.html /online-blackjack permanent
	redir /news-live-casino-guide /ratgeber-live-casino permanent
	redir /news-live-casino-guide.html /ratgeber-live-casino permanent
	redir /news-roulette-regeln-anfaenger /online-roulette permanent
	redir /news-roulette-regeln-anfaenger.html /online-roulette permanent
	redir /news-online-bingo /online-bingo permanent
	redir /news-online-bingo.html /online-bingo permanent

	# Abschliessenden Schraegstrich entfernen: /ratgeber/ lieferte bisher 404.
	# Externe Links und Direkteingaben mit Slash liefen damit ins Leere und
	# verschenkten Linkkraft. Die Wurzel "/" ist ausgenommen, weil das Muster
	# mindestens ein Zeichen vor dem Slash verlangt.
	@trailingslash path_regexp trailslash ^/(.+)/$
	redir @trailingslash /{re.trailslash.1}?{query} permanent

	# .html-Endungen dauerhaft auf die saubere URL umleiten (301, gegen Duplicate Content).
	# Die Bedingung "file" ist wichtig: ohne sie bekaeme JEDE .html-Anfrage einen 301,
	# auch geloeschte Seiten. Google liefe dann von der Weiterleitung in einen 404,
	# statt den 404 direkt zu sehen.
	@htmlext {
		path_regexp htmlext ^/(.+)\.html$
		file {path}
	}
	redir @htmlext /{re.htmlext.1}?{query} permanent

	# --- Wartungsmodus -------------------------------------------------------
	# Das Projekt pausiert. Jeder Seitenaufruf bekommt die Wartungsseite, und
	# zwar mit Status 503 statt 200. Das ist das Signal fuer "voruebergehend
	# nicht verfuegbar" und nicht fuer "geloescht": Suchmaschinen behalten den
	# Bestand vorerst, statt die Seiten aus dem Index zu nehmen.
	# Ausgenommen bleiben Impressum und Datenschutz, weil sie erreichbar sein
	# muessen, dazu robots.txt und die Dateien, die die Wartungsseite braucht.
	# Zum Beenden: diesen Block loeschen oder auskommentieren.
	@wartung {
		not path /wartung.html
		not path /impressum /impressum.html /datenschutz /datenschutz.html
		not path /robots.txt /favicon.png /apple-touch-icon.png
		not path /style.css
		not path /fonts/*
	}
	handle @wartung {
		header Retry-After "604800"
		header Cache-Control "no-store, max-age=0"
		rewrite * /wartung.html
		file_server {
			status 503
		}
	}

	# Saubere URLs intern zur .html-Datei auflösen: /reviews -> /reviews.html
	try_files {path} {path}/ {path}.html
	file_server

	# Bilder lange cachen (ändern sich selten)
	@media path *.png *.jpg *.jpeg *.svg *.ico *.webp *.gif
	header @media Cache-Control "public, max-age=604800"

	# Schriften ein Jahr cachen: die Dateien sind unveränderlich, ein Wechsel
	# bekäme ohnehin einen neuen Dateinamen. Spart wiederkehrenden Besuchern 192 KB.
	@fonts path *.woff2
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	# CSS & JS immer neu prüfen, damit Design-Änderungen sofort ankommen
	@code path *.css *.js
	header @code Cache-Control "public, max-age=0, must-revalidate"

	# Sitemap & Blog-Index immer frisch pruefen (ETag macht die Revalidierung guenstig)
	@data path *.xml *.json
	header @data Cache-Control "public, max-age=0, must-revalidate"
}
